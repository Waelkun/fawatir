{
  "name": "ai-expense-tracker-backend",
  "version": "1.0.0",
  "description": "Backend API for AI Expense Tracker powered by Gemini AI and PostgreSQL",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "build": "node scripts/prepare-postgres.js && npx prisma generate && npx prisma db push --accept-data-loss",
    "prisma:generate": "npx prisma generate",
    "prisma:migrate": "npx prisma migrate dev",
    "prisma:seed": "node prisma/seed.js",
    "db:setup": "node scripts/setup-db.js"
  },
  "dependencies": {
    "@google/generative-ai": "^0.21.0",
    "@prisma/client": "^5.10.2",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.3",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "prisma": "^5.10.2",
    "sharp": "^0.33.2"
  },
  "devDependencies": {
    "nodemon": "^3.1.0"
  }
}
